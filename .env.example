APP_ENV=development

# Configuracoes do Gateway
GATEWAY_PORT=8000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=multistore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
